# 默认：真实 API（de-core）
VITE_USE_MOCK=false
# 推荐留空：浏览器请求同源 /api，由 Vite 代理到本机 de-core（避免直连 127.0.0.1:8080 在部分环境下失败）
VITE_API_BASE=

# 需要浏览器直连后端时再填写，例如：
# VITE_API_BASE=http://127.0.0.1:8080

# 代理目标（仅 Vite 进程读取，非 VITE_ 前缀）
# VITE_PROXY_TARGET=http://127.0.0.1:8080

# 仅本地无后端时启用 Mock（可选）
# VITE_USE_MOCK=true
