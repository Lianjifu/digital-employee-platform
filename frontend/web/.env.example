# 默认：真实 API（monolith 网关 de-gateway :8089 → de-app :8100）
VITE_USE_MOCK=false
# 推荐留空：浏览器请求同源 /api，由 Vite 代理到网关（make compose-up-monolith）
VITE_API_BASE=

# 需要浏览器直连网关时再填写：
# VITE_API_BASE=http://127.0.0.1:8089
# VITE_API_DIRECT=true

# 代理目标（仅 Vite 进程读取）
# VITE_PROXY_TARGET=http://127.0.0.1:8089

# 仅本地无后端时启用 Mock（可选）
# VITE_USE_MOCK=true
