# 默认：真实 API（生产数据模式联调，网关 :8089 → de-app）
VITE_USE_DEMO=false
VITE_USE_MOCK=false
# 推荐留空：浏览器请求同源 /api，由 Vite 代理到网关
VITE_API_BASE=

# 需要浏览器直连网关时再填写：
# VITE_API_BASE=http://127.0.0.1:8089
# VITE_API_DIRECT=true

# 代理目标（仅 Vite 进程读取）
# VITE_PROXY_TARGET=http://127.0.0.1:8089

# 演示环境（前端内存 Handler，可不启后端）：npm run dev:demo
# VITE_USE_DEMO=true
